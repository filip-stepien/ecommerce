{
  "realm": "ecommerce",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Zwykły użytkownik sklepu"
      }
    ]
  },
  "clients": [
    {
      "clientId": "ecommerce-frontend",
      "name": "Ecommerce frontend (SPA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:5173",
      "baseUrl": "/",
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8080/swagger-ui/oauth2-redirect.html"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/*"
      },
      "protocolMappers": [
        {
          "name": "ecommerce-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "ecommerce-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "user",
      "email": "user@example.com",
      "firstName": "Jan",
      "lastName": "Kowalski",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "password",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ]
}
